# ══════════════════════════════════════════════════════
# InvControl — Variables de Entorno
# COPIA este archivo como .env y NO lo subas a Git
# ══════════════════════════════════════════════════════

# URL del Google Apps Script desplegado como Web App
# Obtén esta URL en: Apps Script > Implementar > Web App
VITE_GAS_URL=https://script.google.com/macros/s/TU_ID_AQUI/exec

# Clave de API para autenticar solicitudes al backend
# Debe coincidir con CONFIG.API_KEY en Code.gs
VITE_API_KEY=cambia_esta_clave_secreta_por_una_segura

# Nombre de la aplicación
VITE_APP_NAME=InvControl

# Versión
VITE_APP_VERSION=1.0.0
